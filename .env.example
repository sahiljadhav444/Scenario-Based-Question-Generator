# ==========================================
# Scenario Question Generator - Environment Configuration
# ==========================================

# Application Settings
APP_NAME="Scenario Question Generator"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# LLM Provider API Keys (Set at least one)
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
HUGGINGFACE_API_KEY=""

# Model Configurations
GROQ_MODEL="llama-3.3-70b-versatile"
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"
HUGGINGFACE_MODEL="meta-llama/Meta-Llama-3-70B-Instruct"

# Provider Priority (comma-separated: groq, openrouter, huggingface)
LLM_PROVIDER_ORDER="groq,openrouter,huggingface"

# Generation Parameters
TEMPERATURE=0.2
MAX_TOKENS=2500
REQUEST_TIMEOUT_SECONDS=45
MAX_RETRY_ATTEMPTS=2
